# Never commit real credentials. Copy values into local .env only.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/toi_db
PUBLIC_API_KEY=
# Separate administrator secret for X-Import-Key; not a user's login token.
PUBLIC_IMPORT_KEY=
GEMINI_API_KEY=
# Set an available model ID explicitly; no hardcoded/deprecated model fallback.
GEMINI_MODEL=gemini-3.6-flash
MATCHING_INCLUDE_DEMO=false
AUTO_CREATE_SCHEMA=false
