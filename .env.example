# Never commit real credentials. Copy values into local .env only.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/toi_db
PUBLIC_API_KEY=
# Separate administrator secret for X-Import-Key; not a user's login token.
PUBLIC_IMPORT_KEY=
GEMINI_API_KEY=
# Set an available model ID explicitly; no hardcoded/deprecated model fallback.
GEMINI_MODEL=gemini-3.6-flash
MATCHING_INCLUDE_DEMO=false
AUTO_CREATE_SCHEMA=false
UPLOAD_DIR=./uploads/dogs
AUTO_END_AFTER_SECONDS=3600
AUTO_END_CHECK_INTERVAL_SECONDS=300
INCIDENT_DUPLICATE_WINDOW_SECONDS=180
INCIDENT_LATE_REPORT_HOURS=24
LIVE_WALK_STALE_SECONDS=60
WALK_SUMMARY_MAX_POINTS=2000
# Issue #30 - Signup Rate Limit
SIGNUP_RATE_LIMIT_REQUESTS=5
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=600
# Issue #30 - Availability Rate Limit
AVAILABILITY_RATE_LIMIT_REQUESTS=30
AVAILABILITY_RATE_LIMIT_WINDOW_SECONDS=60
# F-10 - Behavior marker (GPS accuracy above this falls back to the last known location)
WALK_MARKER_MAX_ACCURACY_M=50
WALK_MARKER_MAX_PER_WALK=500
# F-11 - Walk overtime warning (grace period in minutes after expected_end_at)
WALK_OVERDUE_GRACE_MINUTES=0
