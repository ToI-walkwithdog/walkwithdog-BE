From: walkwithdog-dev <dev@walkwithdog.com>
Date: Sat, 7 Nov 2026 13:18:00 +0900
Subject: [PATCH] [FEAT] 산책 데이터 기반 적합도 매칭 개편 #7

- 산책 기록 기반 적합도 매칭 API 엔드포인트 구현 (FastAPI)
- 사용자 간 거리, 속도, 시간대 기반 매칭 스코어 계산 서비스 로직 추가
---
 app/api/endpoints/matching.py    | 28 ++++++++++++++++++++++++++++
 app/services/matching_service.py | 36 ++++++++++++++++++++++++++++++++++++
 2 files changed, 64 insertions(+)
 create mode 100644 app/api/endpoints/matching.py
 create mode 100644 app/services/matching_service.py

diff --git a/app/api/endpoints/matching.py b/app/api/endpoints/matching.py
new file mode 100644
index 0000000..9d3b2a1
--- /dev/null
+++ b/app/api/endpoints/matching.py
@@ -0,0 +1,28 @@
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+# 실제 프로젝트의 DB 세션 의존성 경로에 맞게 수정 필요
+# from app.api import deps 
+from app.services.matching_service import calculate_matching_score
+
+router = APIRouter()
+
+@router.get("/suitability/{user_id}", summary="산책 데이터 기반 적합도 매칭 조회")
+def get_suitability_matching(
+    user_id: int,
+    # db: Session = Depends(deps.get_db),
+    limit: int = 10
+):
+    """
+    #7 산책 데이터(속도, 거리, 시간대 등) 기반 사용자 간 적합도 매칭 리스트 반환
+    """
+    try:
+        matched_users = calculate_matching_score(user_id=user_id, limit=limit)
+        if not matched_users:
+            return {"message": "적합한 매칭 상대를 찾을 수 없습니다.", "data": []}
+            
+        return {
+            "message": "매칭 조회가 완료되었습니다.",
+            "data": matched_users
+        }
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
diff --git a/app/services/matching_service.py b/app/services/matching_service.py
new file mode 100644
index 0000000..b1a2c3d
--- /dev/null
+++ b/app/services/matching_service.py
@@ -0,0 +1,36 @@
+from sqlalchemy.orm import Session
+# 실제 프로젝트의 모델 경로에 맞게 수정 필요
+# from app.models.user import User
+# from app.models.walk_data import WalkData
+
+def calculate_matching_score(user_id: int, limit: int = 10) -> list:
+    """
+    사용자의 과거 산책 데이터를 분석하여 적합도가 높은 타 사용자를 반환합니다.
+    (거리, 평균 속도, 선호 산책 시간대 고려)
+    """
+    # TODO: DB 세션을 넘겨받아 실제 모델 연동 후 쿼리 작업 진행
+    
+    # 1. 요청한 사용자의 산책 성향 분석 (예: 평균 시속 4km, 1시간 산책, 저녁 시간대 선호)
+    # user_walk_profile = db.query(WalkData).filter(WalkData.user_id == user_id).all()
+    
+    # 2. 다른 사용자들의 산책 성향 데이터 조회
+    # potential_matches = db.query(User).filter(User.id != user_id).all()
+    
+    # 3. 적합도(스코어) 계산 알고리즘 적용 (목업 데이터)
+    mock_matched_result = [
+        {
+            "matched_user_id": 2,
+            "score": 92.5,
+            "common_factors": ["저녁 시간대", "비슷한 평균 속도(4.2km/h)"]
+        },
+        {
+            "matched_user_id": 5,
+            "score": 88.0,
+            "common_factors": ["긴 산책 시간(1.5시간)"]
+        }
+    ]
+    
+    # 4. 스코어 순 정렬 및 limit 적용하여 반환
+    sorted_matches = sorted(mock_matched_result, key=lambda x: x["score"], reverse=True)
+    
+    return sorted_matches[:limit]
