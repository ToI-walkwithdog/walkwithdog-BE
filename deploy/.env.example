# Local Compose template (#128). Copy to deploy/.env; fill synthetic local credentials first.
# This file is NOT a runnable configuration. Use --env-file deploy/.env explicitly.
# Do not use this combined local file for EC2 or commit runtime files.

# Compose settings and PostgreSQL bootstrap credentials (local only).
POSTGRES_USER=toi
# Required [secret]: synthetic local password; never commit an actual value.
POSTGRES_PASSWORD=
POSTGRES_DB=toi_db
API_PORT=8000
# Optional image and runtime env-file path (Compose defaults apply).
# API_IMAGE=
# API_ENV_FILE=

# Required [secret]: PostgreSQL connection URL; fill before starting the API.
# Use db:5432 for Compose. Percent-encode URL credentials.
DATABASE_URL=

# Required [non-secret]: runtime environment and Mock SMS provider (#124).
APP_ENV=local
SMS_PROVIDER=mock
# Optional for isolated container tests [secret]: exactly six ASCII digits.
# Only with mock and local/development/test; unset or empty keeps random codes.
# Fixed codes do not prove phone ownership; use only synthetic 010-0000-XXXX numbers and a separate test DB.
SMS_MOCK_FIXED_CODE=
# Required for phone verification [secret]: at least 32 characters, unique per environment.
PHONE_VERIFICATION_HMAC_KEY=

# Required for shelter walk-start codes [secret, #118]: at least 32 characters; different from phone HMAC key.
SHELTER_CODE_HMAC_KEY=
# Required for pledge, signup and policy lookup [non-secret, #118]: approved versions only.
PLEDGE_CURRENT_VERSION=
PRIVACY_DOCUMENT_VERSION=
TERMS_DOCUMENT_VERSION=
# Required list must be explicitly present; an empty list means none, NOT an undecided policy.
# The blank template is not approved for signup. #118 must decide the list before enabling signup.
# Allowed types: PRIVACY_COLLECTION_USE, AI_OVERSEAS_TRANSFER; comma-separated, no overlap.
PRIVACY_REQUIRED_CONSENTS=
# Optional list: unset or empty means none.
PRIVACY_OPTIONAL_CONSENTS=
# Optional: default is the repository/image policies directory.
# POLICY_DOCUMENTS_DIR=
# Optional [non-secret, #118]: both set or both empty; version <=64 chars, UTC ISO 8601 start.
VOLUNTEER_LEVEL_POLICY_VERSION=
VOLUNTEER_LEVEL_POLICY_START_AT=

# Required for location [non-secret, #117]: approved provider (mock or kakao).
# Mock requires local/development/test and seeded active region 11680.
LOCATION_GEOCODING_PROVIDER=mock
# Keep external transfer disabled until #117 approves notice, consent and provider configuration.
LOCATION_EXTERNAL_TRANSFER_ENABLED=false
# Required only for approved Kakao transfer [secret, #117].
KAKAO_REST_API_KEY=

# Optional public-data import [secrets, #116]; separate import key, not a user login token.
PUBLIC_API_KEY=
PUBLIC_IMPORT_KEY=
# Optional [non-secret, #116]: demo dogs excluded from matching by default.
MATCHING_INCLUDE_DEMO=false
# Optional Gemini chat [secret + non-secret]: decide use/model separately before setting both.
GEMINI_API_KEY=
GEMINI_MODEL=

# Account exit retention is undecided; keep unset (never enable deletion for the demo).
# ACCOUNT_EXIT_RECORD_POLICY=
# Compose pins these settings at startup; do not override them.
AUTO_CREATE_SCHEMA=false
UPLOAD_DIR=/srv/uploads/dogs

# Optional tuning values: code defaults; uncomment only when explicitly needed.
# SIGNUP_RATE_LIMIT_REQUESTS=5
# SIGNUP_RATE_LIMIT_WINDOW_SECONDS=600
# AVAILABILITY_RATE_LIMIT_REQUESTS=30
# AVAILABILITY_RATE_LIMIT_WINDOW_SECONDS=60
# LOGIN_RATE_LIMIT_REQUESTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# ACCOUNT_EXIT_PASSWORD_FAILURE_LIMIT=5
# ACCOUNT_EXIT_PASSWORD_FAILURE_WINDOW_SECONDS=900
# AUTO_END_AFTER_SECONDS=3600
# AUTO_END_CHECK_INTERVAL_SECONDS=300
# INCIDENT_DUPLICATE_WINDOW_SECONDS=180
# INCIDENT_LATE_REPORT_HOURS=24
# LIVE_WALK_STALE_SECONDS=60
# WALK_SUMMARY_MAX_POINTS=2000
# WALK_MARKER_MAX_ACCURACY_M=50
# WALK_MARKER_MAX_PER_WALK=500
# WALK_OVERDUE_GRACE_MINUTES=0
