# Copy to deploy/.env for a local container stack. Values below are for isolated local use only.
# Pass deploy/.env explicitly with Docker Compose --env-file. Do not commit runtime files.

# Compose settings and PostgreSQL bootstrap credentials
POSTGRES_USER=toi
POSTGRES_PASSWORD=local_container_only
POSTGRES_DB=toi_db
API_PORT=8000
# API_IMAGE=ACCOUNT.dkr.ecr.REGION.amazonaws.com/REPOSITORY:TAG
# API_ENV_FILE=./deploy/.env.api

# FastAPI runtime settings. Keep the DB host as the Compose service name.
DATABASE_URL=postgresql://toi:local_container_only@db:5432/toi_db
# Compose pins AUTO_CREATE_SCHEMA=false and UPLOAD_DIR=/srv/uploads/dogs at startup.

APP_ENV=local
SMS_PROVIDER=mock
# Set a test-only secret of at least 32 characters to exercise SMS verification.
PHONE_VERIFICATION_HMAC_KEY=
LOCATION_GEOCODING_PROVIDER=mock
LOCATION_EXTERNAL_TRANSFER_ENABLED=false
